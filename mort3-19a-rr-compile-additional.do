/*==============================================================================
 COMPILE ALL ADDITIONAL-ANALYSIS TABLES INTO ONE WORD DOCUMENT
 Inputs : $output/table_*.docx (from do-files 10a-13c) and $output/fig_*.png
 Output : $od/manuscript/late death v3 - additional analyses v1.0 <date>.docx
 RCR (Claude-assisted) 23 Oct 2026
==============================================================================*/
do "/Users/raoulreulen/Documents/GitHub/mort3/mort3-00c-rr-setwd-mac.do"

local date : display %tdDDMonCCYY date("`c(current_date)'", "DMY")
local outfile "$od/manuscript/late death v3 - additional analyses v1.0 `date'.docx"

local tables ///
	table_era_poisson table_sex_smraer table_period_2010_2022 ///
	table_lel table_lyl_bycause table_mortality_age_gap ///
	table_multiple_cause table_sensitivity

local figs ///
	fig_lel_bydiag fig_le_bydecade fig_lyl_bycause fig_mortality_age_gap ///
	fig_aer_heatmap fig_smr_heatmap fig_multiple_cause

putdocx clear
putdocx begin, font("Arial Narrow", 10) landscape
putdocx paragraph, style(Title)
putdocx text ("BCCSS late mortality: additional analyses (draft `date')")
putdocx paragraph
putdocx text ("Generated by mort3-19a-rr-compile-additional.do from do-files mort3-10a to mort3-13c. "), italic
putdocx text ("Follow-up to 31 Dec 2022; general-population rates 1950-2024 (England & Wales)."), italic
putdocx save "`outfile'", replace

foreach t of local tables {
	cap confirm file "$output/`t'.docx"
	if _rc {
		di as error "missing: `t'.docx"
		continue
	}
	putdocx append "`outfile'" "$output/`t'.docx", saving("`outfile'", replace)
}

putdocx clear
putdocx begin, font("Arial Narrow", 10) landscape
putdocx paragraph, style(Heading1)
putdocx text ("Figures")
foreach f of local figs {
	cap confirm file "$output/`f'.png"
	if _rc {
		di as error "missing: `f'.png"
		continue
	}
	putdocx paragraph, style(Heading2)
	putdocx text ("`f'")
	putdocx paragraph
	putdocx image "$output/`f'.png", width(9in)
	putdocx pagebreak
}
tempfile figdoc
putdocx save "`figdoc'.docx", replace
putdocx append "`outfile'" "`figdoc'.docx", saving("`outfile'", replace)
di as result "saved: `outfile'"
exit
